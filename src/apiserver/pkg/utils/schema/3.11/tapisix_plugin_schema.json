    "log-replay": {
      "priority": 455,
      "schema": {
        "$comment": "this is a mark for our injected plugin schema",
        "properties": {
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "default": 3
          },
          "max_retry_count": {
            "type": "integer",
