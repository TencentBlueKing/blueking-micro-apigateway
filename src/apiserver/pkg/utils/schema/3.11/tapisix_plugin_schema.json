    "trpc-transcode": {
      "priority": 677,
      "schema": {
        "$comment": "this is a mark for our injected plugin schema",
        "properties": {
          "proto_id": {
            "description": "the trpc proto id",
            "type": "string"
          },
          "service": {
            "description": "the trpc service_name",
            "type": "string"
          },
          "method": {
            "description": "the trpc method",
            "type": "string"
          },
          "timeout": {
            "description": "trpc call timeout",
            "type": "integer",
            "default": 2000
          },
          "is_passthrough": {
            "description": "body passthrough or encode",
            "type": "boolean",
            "default": false
          },
          "trpc_version": {
            "description": "trpc version, v0.8.5",
            "type": "string",
            "default": "v2.0.0"
          }
        },
        "additionalProperties": true,
        "required": [
          "proto_id"
        ],
        "type": "object"
      },
      "scope": "global",
      "version": 0.1
    },
    "trpc-canary": {
