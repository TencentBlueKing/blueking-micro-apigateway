        ],
        "type": "object"
      },
      "scope": "global",
      "version": 0.1
    },
    "pangu-authn": {
      "priority": 2570,
      "schema": {
        "type": "object",
        "required": [
          "project_id",
          "domains"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          },
          "cookie_expire_seconds": {
            "type": "integer",
            "default": 3600
          },
          "pangu_customerParams": {
            "type": "string",
            "default": ""
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "token": {
            "type": "string",
            "default": ""
          },
          "login_type": {
            "type": "string",
            "enum": [
              "qqconnect",
              "oa"
            ],
            "default": "oa"
          },
          "qqconnect": {
            "type": "object",
            "properties": {
              "appid": {
                "type": "string",
                "default": ""
              },
              "appkey": {
                "type": "string",
                "default": ""
              }
            },
            "required": [
              "appid"
            ]
          },
          "skip_path_list": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "login_type": {
                  "const": "qqconnect"
                }
              },
              "type": "object"
            },
            "then": {
              "required": [
                "qqconnect"
              ]
            }
          }
        ]
      },
      "scope": "global",
      "version": 0.1
    },
