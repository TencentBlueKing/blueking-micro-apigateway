          }
        },
        "required": [
          "uri"
        ],
        "type": "object"
      },
      "scope": "global",
      "version": 0.1
    },
    "downgrade-cache": {
      "priority": 850,
      "schema": {
        "$comment": "this is a mark for our injected plugin schema",
        "properties": {
          "cache_mode": {
            "type": "string",
            "enum": [
              "passive",
              "active"
            ]
          },
          "cache_key": {
            "type": "array",
            "minItems": 1,
            "items": {
              "description": "a key for caching",
              "type": "string",
              "pattern": "^(^[^\\$].+$|^\\$[0-9a-zA-Z_]+$)"
            },
            "default": [
              "$host",
              "$request_uri"
            ]
          },
          "cache_http_status": {
            "type": "array",
            "minItems": 1,
            "items": {
              "description": "http response status",
              "type": "integer",
              "minimum": 200,
              "maximum": 599
            },
            "uniqueItems": true,
            "default": [
              200,
              301,
              404
            ]
          },
          "frame_ret_header_var": {
            "type": "string",
            "default": "trpc-ret"
          },
          "func_ret_header_var": {
            "type": "string",
            "default": "trpc-func-ret"
          },
          "error_frame_ret": {
            "type": "array",
            "minItems": 1,
            "items": {
              "description": "frame response error code",
              "type": "string"
            },
            "uniqueItems": true,
            "default": [
              "21",
              "22",
              "101",
              "111",
              "131",
              "141"
            ]
          },
          "error_func_ret": {
            "type": "array",
            "minItems": 0,
            "items": {
              "description": "func response error code",
              "type": "string"
            },
            "uniqueItems": true,
            "default": []
          },
          "error_http_status": {
            "type": "array",
            "minItems": 1,
            "items": {
              "description": "http response error status",
              "type": "integer",
              "minimum": 200,
              "maximum": 599
            },
            "uniqueItems": true,
            "default": [
              500,
              501,
              502,
              503,
              504
            ]
          },
          "cache_method": {
            "type": "array",
            "minItems": 1,
            "items": {
              "description": "supported http method",
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "HEAD"
              ]
            },
            "uniqueItems": true,
            "default": [
              "GET",
              "HEAD"
            ]
          },
          "cache_ttl": {
            "type": "integer",
            "minimum": 1,
            "default": 300
          },
          "cache_freq": {
            "type": "integer",
            "minimum": 1,
            "default": 5
          },
          "buffer_duration": {
            "type": "integer",
            "minimum": 1,
            "default": 3
          },
          "inactive_timeout": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "batch_max_size": {
            "type": "integer",
            "minimum": 1,
            "default": 50
          },
          "max_retry_count": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        },
        "type": "object"
      },
      "scope": "global",
      "version": 0.1
    },
    "cls-logger": {
      "priority": 399,
      "metadata_schema": {
        "properties": {
          "log_format": {
            "default": {
              "@timestamp": "$time_iso8601",
              "client_ip": "$remote_addr",
              "host": "$host"
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "schema": {
        "$comment": "this is a mark for our injected plugin schema",
        "properties": {
          "cls_host": {
            "type": "string"
          },
          "cls_topic": {
            "type": "string"
          },
          "secret_id": {
            "type": "string"
          },
          "secret_key": {
            "type": "string"
          },
          "sample_rate": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 100
          },
          "include_req_body": {
            "type": "boolean",
            "default": false
          },
          "include_resp_body": {
            "type": "boolean",
            "default": false
          },
          "global_tag": {
            "type": "object"
          },
          "log_format": {
            "type": "object"
          }
        },
        "required": [
          "cls_host",
          "cls_topic",
          "secret_id",
          "secret_key"
        ],
        "type": "object"
      },
      "scope": "global",
      "version": 0.1
    }
  }
}
