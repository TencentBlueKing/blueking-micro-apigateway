    },
    "polaris-limit": {
      "priority": 1004,
      "schema": {
        "$comment": "this is a mark for our injected plugin schema",
        "properties": {
          "rejected_code": {
            "type": "integer",
            "minimum": 200,
            "maximum": 599,
            "default": 503
          },
          "rejected_msg": {
            "type": "string",
            "minLength": 1
          },
          "allow_degradation": {
            "type": "boolean",
            "default": false
          },
          "labels": {
            "type": "object",
            "minItems": 1
          },
          "polaris_namespace": {
            "type": "string"
          },
          "polaris_server_name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "scope": "global",
      "version": 0.1
    },
    "polaris-circuit-breaker": {
      "priority": 505,
      "schema": {
        "$comment": "this is a mark for our injected plugin schema",
        "properties": {
          "healthy": {
            "type": "object",
            "properties": {
              "ok_status": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 599
                },
                "uniqueItems": true,
                "default": [
                  200,
                  301,
                  302
                ]
              }
            },
            "default": {
              "ok_status": [
                200,
                301,
                302
              ]
            },
            "required": [
              "ok_status"
            ]
          },
          "unhealthy": {
            "type": "object",
            "properties": {
              "timeout_status": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 599
                },
                "uniqueItems": true,
                "default": [
                  504
                ]
              },
              "error_status": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 599
                },
                "uniqueItems": true,
                "default": [
                  429,
                  404,
                  500,
                  501,
                  502,
                  503,
                  504,
                  505
                ]
              }
            },
            "default": {
              "timeout_status": [
                504
              ],
              "error_status": [
                429,
                404,
                500,
                501,
                502,
                503,
                504,
                505
              ]
            },
            "required": [
              "timeout_status",
              "error_status"
            ]
          }
        },
        "additionalProperties": true,
        "required": [
          "healthy",
          "unhealthy"
        ],
        "type": "object"
      },
      "scope": "global",
      "version": 0.1
    },
    "pangu-wolf-rbac": {
      "priority": 1,
      "schema": {
        "$comment": "this is a mark for our injected plugin schema",
        "properties": {
          "project_id": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "white_list": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path_prefix": {
            "type": "string",
            "default": "/"
          }
        },
        "required": [
          "project_id",
          "token",
          "white_list"
        ],
        "type": "object"
      },
