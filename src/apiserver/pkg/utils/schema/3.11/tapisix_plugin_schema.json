              "type": "object",
              "properties": {
                "match": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "vars": {
                        "type": "array"
                      }
                    }
                  }
                },
                "trans_info": {
                  "type": "object"
                }
              }
            }
          }
        },
        "type": "object"
      },
      "scope": "global",
      "version": 0.1
    },
