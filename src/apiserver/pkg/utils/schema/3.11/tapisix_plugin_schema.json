            "type": "string",
            "default": "0.0.0"
          },
          "app_id": {
            "type": "string",
            "minLength": 1
          },
          "app_key": {
            "type": "string",
            "minLength": 1
          },
          "sample_ratio": {
            "type": "number",
            "minimum": 0.00001,
            "maximum": 1,
            "default": 1
          },
          "sample_with_opentelemetry": {
            "type": "boolean",
            "default": false
          },
          "include_req_body": {
            "type": "boolean",
            "default": true
          }
        },
        "type": "object"
      },
      "scope": "global",
