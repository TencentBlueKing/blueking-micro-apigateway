    "bk-header-rewrite": {
      "priority": 17421,
      "schema": {
        "$comment": "this is a mark for our injected plugin schema",
        "additionalProperties": false,
        "description": "new headers for request",
        "minProperties": 1,
        "properties": {
          "remove": {
            "items": {
              "pattern": "^[^:]+$",
              "type": "string"
            },
            "type": "array"
          },
          "set": {
            "patternProperties": {
              "^[^:]+$": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "scope": "stage_and_resource",
      "version": 0.1
    },
