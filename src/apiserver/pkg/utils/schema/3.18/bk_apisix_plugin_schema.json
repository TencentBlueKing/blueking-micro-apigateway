    "bk-login-required": {
      "priority": 1900,
      "schema": {
        "$comment": "this is a mark for our injected plugin schema",
        "properties": {
          "add_header_username": {
            "default": true,
            "description": "Whether to add username header",
            "type": "boolean"
          },
          "auth_type": {
            "description": "Authentication type",
            "enum": [
              "bk_token",
              "bk_ticket"
            ],
            "type": "string"
          },
          "bk_app_code": {
            "description": "BlueKing application code",
            "type": "string"
          },
          "bk_app_secret": {
            "description": "BlueKing application secret",
            "type": "string"
          },
          "bk_tenant_id": {
            "description": "BlueKing tenant ID",
            "type": "string"
          },
          "url": {
            "description": "API endpoint URL",
            "type": "string"
          }
        },
        "required": [
          "auth_type",
          "url"
        ],
        "type": "object"
      },
      "scope": "global",
      "version": 0.1
    },
    "bk-traffic-label": {
      "priority": 17460,
      "schema": {
        "$comment": "this is a mark for our injected plugin schema",
        "properties": {
          "_meta": {
            "additionalProperties": false,
            "properties": {
              "disable": {
                "type": "boolean"
              },
              "error_response": {
