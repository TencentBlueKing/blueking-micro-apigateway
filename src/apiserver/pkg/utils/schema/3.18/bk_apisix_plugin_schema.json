                "type": "string"
              },
              "priority": {
                "description": "priority of plugins by customized order",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "rules": {
            "items": {
              "properties": {
                "actions": {
                  "items": {
                    "properties": {
                      "set_headers": {
                        "additionalProperties": {
                          "type": "string"
                        },
                        "type": "object"
                      },
                      "weight": {
                        "default": 1,
                        "description": "percentage of all matched which would do the actions",
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "type": "object"
                  },
                  "maxItems": 20,
                  "minItems": 1,
                  "type": "array"
                },
                "match": {
                  "type": "array"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "rules"
        ],
        "type": "object"
      },
      "version": 0.1
    }
