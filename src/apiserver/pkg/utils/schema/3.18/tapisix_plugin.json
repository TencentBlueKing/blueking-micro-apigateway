  {
    "name": "downgrade-cache",
    "type": "tapisix",
    "example": {
      "cache_mode": "passive",
      "cache_key": [
        "$host",
        "$request_uri"
      ],
      "cache_http_status": [
        200,
        301,
        404
      ],
      "frame_ret_header_var": "trpc-ret",
      "func_ret_header_var": "trpc-func-ret",
      "error_frame_ret": [
        "21",
        "22",
        "101",
        "111",
        "131",
        "141"
      ],
      "error_func_ret": [],
      "error_http_status": [
        500,
        501,
        502,
        503,
        504
      ],
      "cache_method": [
        "GET",
        "HEAD"
      ],
      "cache_ttl": 300,
      "cache_freq": 5,
      "buffer_duration": 3,
      "inactive_timeout": 1,
      "batch_max_size": 50,
      "max_retry_count": 0
    }
  },
  {
