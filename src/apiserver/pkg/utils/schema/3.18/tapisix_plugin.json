    }
  },
  {
    "name": "polaris-circuit-breaker",
    "type": "tapisix",
    "example": {
      "healthy": {
        "ok_status": [
          200,
          301,
          302
        ]
      },
      "unhealthy": {
        "timeout_status": [
          504
        ],
        "error_status": [
          429,
          404,
          500,
          501,
          502,
          503,
          504,
          505
        ]
      }
    }
  },
