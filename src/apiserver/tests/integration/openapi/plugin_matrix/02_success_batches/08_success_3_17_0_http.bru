  X-BK-API-TOKEN: {{x_bk_api_token}}
}

body {
  [
    {
      "config": {
        "methods": [
          "GET"
        ],
        "plugins": {
          "proxy-buffering": {
            "disable_proxy_buffering": true
          }
        },
        "upstream": {
          "nodes": [
            {
              "host": "httpbin.org",
              "port": 80,
              "weight": 1
            }
          ],
          "scheme": "http",
          "type": "roundrobin"
        },
        "uris": [
          "/plugin-proxy-buffering-317"
        ]
      },
      "name": "plugin-proxy-buffering-317"
    },
    {
      "config": {
        "methods": [
          "GET"
        ],
        "plugins": {
          "oas-validator": {
            "spec": "{\"openapi\":\"3.0.0\",\"info\":{\"title\":\"Example\",\"version\":\"1.0.0\"},\"paths\":{}}"
          }
        },
        "upstream": {
          "nodes": [
            {
              "host": "httpbin.org",
              "port": 80,
              "weight": 1
            }
          ],
          "scheme": "http",
          "type": "roundrobin"
        },
        "uris": [
          "/plugin-oas-validator-317"
        ]
      },
      "name": "plugin-oas-validator-317"
    },
    {
      "config": {
        "methods": [
          "GET"
        ],
        "plugins": {
          "ai-rate-limiting": {
            "limit": 300,
            "limit_strategy": "prompt_tokens",
            "time_window": 30
          }
        },
        "upstream": {
          "nodes": [
            {
              "host": "httpbin.org",
              "port": 80,
              "weight": 1
            }
          ],
          "scheme": "http",
          "type": "roundrobin"
        },
        "uris": [
          "/plugin-ai-rate-limiting-317"
        ]
      },
      "name": "plugin-ai-rate-limiting-317"
    }
  ]
}

assert {
