          "nodes": [
            {
              "host": "httpbin.org",
              "port": 80,
              "weight": 1
            }
          ],
          "scheme": "http",
          "type": "roundrobin"
        },
        "uris": [
          "/plugin-ai-lakera-guard-318"
        ]
      },
