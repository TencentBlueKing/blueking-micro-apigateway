meta {
  name: plugin_matrix_success_3_18_0_metadata
  type: http
  seq: 13
}

post {
  url: {{scheme}}://{{host}}/api/v1/open/gateways/bk-apisix-plugin-matrix-318/resources/plugin_metadatas/
}

headers {
  Content-Type: application/json
  X-BK-API-TOKEN: {{x_bk_api_token}}
}

body {
  [
    {
      "config": {
        "id": "kafka-logger",
